# Copia este archivo como api.env (local) o pon estas variables en tu servidor
GEMINI_API_KEY=tu_clave_de_google_ai_studio
SECRET_KEY=una_frase_larga_y_aleatoria
# Modo Rápido (por defecto) y modo Avanzado
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_PRO=gemini-3.8-flash
# Si el principal está saturado (503) o sin cuota (429), prueba estos:
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.7-flash
GEMINI_MEMORY_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_S=15
# Vacío = SQLite local (asistente.db). En el servidor usa Postgres (Supabase):
DATABASE_URL=
# 1 = cualquiera puede crear cuenta; 0 = solo el primer usuario (tú)
ALLOW_REGISTRATION=1
# 1 = busca en internet gratis (DuckDuckGo) cuando la pregunta necesita datos actuales
ENABLE_WEB_SEARCH=1
# 1 = Gemini busca en Google (requiere plan de pago en AI Studio; con el gratuito da error 429)
ENABLE_GOOGLE_SEARCH=0
# 1 = permite "abre youtube" etc. (solo en tu PC Windows y solo para el admin)
ENABLE_LOCAL_APPS=0
# Opcional: tu dominio fijo gratis de ngrok (dashboard.ngrok.com > Domains), ej. jlg-ai.ngrok-free.app
NGROK_DOMAIN=
